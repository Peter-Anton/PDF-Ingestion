# PostgreSQL connection
POSTGRES_USER=raguser
POSTGRES_PASSWORD=admin123
POSTGRES_DB=ragdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=ragdb

# Application
APP_NAME=BrightSkies
APP_VERSION=1.0.0

# Embedding configuration
EMBEDDING_BACKEND=LOCAL
EMBEDDING_MODEL_ID=all-minilm
EMBEDDING_MODEL_SIZE=384

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Search
TOP_K=5

# File ingestion
ALLOWED_DIRECTORY=/data